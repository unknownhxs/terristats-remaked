# Discord bot token (required) - https://discord.com/developers/applications
DISCORD_TOKEN=your_token

# MongoDB connection. Either provide a full URI...
MONGO_URI=mongodb://localhost:27017/

# ...or the individual parts (used only when MONGO_URI is not set):
# MONGO_USERNAME=
# MONGO_PASSWORD=
# MONGO_HOST=localhost

# Optional: register slash commands instantly in a single guild during
# development. Leave empty to register commands globally.
# GUILD_ID=

# Optional: health-check web server port (defaults to 8000).
# PORT=8000
